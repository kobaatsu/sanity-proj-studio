# Yahoo!デベロッパーネットワークで発行した Client ID (アプリケーションID) を設定してください
# https://developer.yahoo.co.jp/
SANITY_STUDIO_YAHOO_CLIENT_ID=

SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# お知らせ入稿時のカテゴリー提案機能（TypeSafe連携）が呼び出す web-nextjs のURL
# ローカル開発では未設定のままでよい（http://localhost:3000 にフォールバックする）。
# TypeSafe API Keyは web-nextjs 側の .env.local で管理する
SANITY_STUDIO_TYPESAFE_PROXY_URL=

# 上記エンドポイント (/api/typesafe/suggest-news-category) 用の共有シークレット
# web-nextjs側の .env.local の INTERNAL_API_SECRET と同じ値を設定してください
SANITY_STUDIO_INTERNAL_API_SECRET=

# --- 本番デプロイ (sanity deploy) 専用の設定 ---
# 上記2つの値のうち本番用のものは、.env.local ではなく .env.production.local に書く。
# Vite/Sanity CLIの規約により、sanity build/deploy 実行時は
# .env.production.local が .env.local より優先して読み込まれるため、
# ローカル開発用の値(.env.local)を書き換えずに本番用の値を分離できる。
# .env.production.local.example を参考に作成すること（*.local はgit管理対象外）。
