# sanity deploy (本番Studio公開) 時にのみ使う環境変数。
# .env.local より優先して読み込まれる (Vite/Sanity CLIの規約)。
# cp .env.production.local.example .env.production.local してから値を設定すること。

# お知らせ入稿時のカテゴリー提案機能（TypeSafe連携）が呼び出す web-nextjs の本番URL
# 例: https://web-nextjs-psi.vercel.app
SANITY_STUDIO_TYPESAFE_PROXY_URL=

# 上記エンドポイント (/api/typesafe/suggest-news-category) 用の共有シークレット
# web-nextjs側 Vercel Production環境の INTERNAL_API_SECRET と同じ値を設定してください
SANITY_STUDIO_INTERNAL_API_SECRET=

# Presentation Tool（ライブプレビュー）が参照する web-nextjs の本番URL
# 例: https://web-nextjs-psi.vercel.app
SANITY_STUDIO_PREVIEW_URL=
